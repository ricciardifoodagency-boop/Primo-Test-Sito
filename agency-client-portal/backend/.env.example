# Porta su cui gira il server
PORT=3000

# Chiave che l'app mobile deve inviare nell'header x-api-key per autenticarsi.
# Genera una stringa lunga e casuale, es: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_API_KEY=genera-una-stringa-lunga-e-casuale

# Un token di accesso Meta (permesso ads_read) per ogni cliente. Il nome della
# variabile deve combaciare col campo metaAccessTokenEnvVar in src/clients.json.
# NON committare mai questo file coi valori reali: solo .env.example va in git,
# .env resta locale/sul server.
META_TOKEN_RICCIARDI_FOOD_AGENCY=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
