{
  "expo": {
    "name": "client-portal-revolucion-mexico",
    "slug": "client-portal-revolucion-mexico",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clientportalrevolucionmexico",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ricciardifoodagency.portal",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.ricciardifoodagency.portal",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/app"
    },
    "extra": {
      "clientId": "ricciardi-food-agency",
      "backendUrl": "http://localhost:3000",
      "apiKey": "",
      "brandColor": "#C1121F",
      "router": {},
      "eas": {
        "projectId": "6d6e2db4-51b7-4c0d-a69e-c2135c8f06f9"
      }
    },
    "owner": "emrakul"
  }
}
